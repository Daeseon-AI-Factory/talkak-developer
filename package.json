{
  "name": "talkak-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "broker:debug": "node scripts/build-broker-sidecar.mjs --profile debug",
    "broker:release": "node scripts/build-broker-sidecar.mjs --profile release",
    "dev": "vite",
    "ci:contract": "node --test scripts/desktopCiContract.mutants.mjs && node scripts/check-desktop-ci.mjs",
    "e2e:windows": "wdio run ./wdio.windows.conf.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "tsc && vite build && node scripts/check-webdriver-bundle.mjs absent",
    "build:webdriver-ci": "tsc && vite build --mode webdriver-ci && node scripts/check-webdriver-bundle.mjs present",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "9.30.0",
    "@wdio/local-runner": "9.30.0",
    "@wdio/mocha-framework": "9.30.0",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.8",
    "webdriverio": "9.30.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  }
}
