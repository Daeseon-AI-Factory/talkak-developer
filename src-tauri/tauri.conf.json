{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talkak Dev",
  "version": "0.1.1",
  "identifier": "dev.talkak.desktop",
  "build": {
    "beforeDevCommand": "pnpm broker:debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm broker:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talkak Dev",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "externalBin": ["binaries/talkak-dev-broker"],
    "windows": {
      "nsis": {
        "languages": ["English", "Korean"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Daeseon-AI-Factory/talkak-developer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwODVDRDk2RTVDMUZEOTUKUldTVi9jSGxsczJGZ0E3RGZUdjhLSHpUS1dvWFRWL2I4cGNuSWNxMGQ2RkFDampwTnpiVm1pR2UK"
    }
  }
}
