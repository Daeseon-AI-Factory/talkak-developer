{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talkak Dev",
  "version": "0.1.0",
  "identifier": "dev.talkak.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talkak Dev",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
